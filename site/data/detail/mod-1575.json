{"kind": "mod", "id": 1575, "name": "Increase Climb Height", "slug": "increase-climb-height", "teaser": "Increases the height at which you can perform a climb.", "owner_name": "redlaser42", "downloads": 116570, "favourites": 92, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": null, "guid": "redlaser42.increaseclimbheight", "thumbnail_local": null, "category": "Other", "category_id": 17, "updated_at": "2026-07-28T09:47:44.000000Z", "created_at": "2024-07-19T03:51:53.000000Z", "published_at": "2024-07-19T03:51:00.000000Z", "latest_constraint": "~4.0 <4.1.0", "latest_version": "2.0.1", "has_local": false, "has_github": false, "license_link": null, "description_html": "<p>Add verticality to your gameplay. Access previously inaccessible roofs. Hop fences you know you could hop irl.</p>\n<p>This works much better than I ever thought it would. I have never gotten wedged or stuck outside the map anywhere. It works on all objects. Just look up a little and hold space.</p>\n<div class=\"youtube-lite\" data-video-id=\"1WVKBJ5D3W0\" data-embed-url=\"https://www.youtube-nocookie.com/embed/1WVKBJ5D3W0?autoplay=1\"><img src=\"https://i.ytimg.com/vi/1WVKBJ5D3W0/hqdefault.jpg\" alt=\"YouTube video thumbnail\" loading=\"lazy\" decoding=\"async\" /></div>\n<p>Let me know if you find any good new spots. I have only played Woods.</p>\n", "versions": [{"version": "1.1.0", "spt_version_constraint": "~3.8.0", "content_length": null, "downloads": 3060, "published_at": "2024-07-19T18:40:49.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1575/increase-climb-height/1.1.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.2.0", "spt_version_constraint": "~3.8.0", "content_length": null, "downloads": 18921, "published_at": "2024-07-24T02:12:13.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1575/increase-climb-height/