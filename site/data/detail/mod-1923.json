{"kind": "mod", "id": 1923, "name": "Lockable Doors", "slug": "lockable-doors", "teaser": "Lock doors so that bots can't come in!", "owner_name": "Jehree", "downloads": 13113, "favourites": 19, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "MIT License", "guid": "com.jehree.lockabledoorsserver", "thumbnail_local": null, "category": null, "category_id": null, "updated_at": "2026-07-28T07:07:18.000000Z", "created_at": "2024-12-28T23:44:37.000000Z", "published_at": "2024-12-28T23:44:37.000000Z", "latest_constraint": "~4.0.8", "latest_version": "2.0.0", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<p>Does what it says on the tin!**</p>\n<p><em><strong>Use this with <a target=\"_blank\" class=\"external-link\" href=\"https://hub.sp-tarkov.com/files/file/2572-leave-it-there/\" rel=\"noreferrer noopener\">Leave It There</a> to set up your own little space in raid where you can store your things in peace without bots breathing down your neck!</strong></em></p>\n<p><a target=\"_blank\" class=\"external-link\" href=\"https://github.com/Jehree/GifDump/blob/add-new-file/LockableDoorsShowcase.gif?raw=true\" rel=\"noreferrer noopener\"><img loading=\"lazy\" decoding=\"async\" src=\"https://github.com/Jehree/GifDump/blob/add-new-file/LockableDoorsShowcase.gif?raw=true\" alt=\"LockableDoorsShowcase.gif?raw=true\" /></a></p>\n<p><strong>Features:</strong></p>\n<ul>\n<li>Doors will have a prompt to lock or unlock them.</li>\n<li>Locked doors cannot be opened by bots, and also have nav-mesh obstacles attached to them so bots will know the area is inaccessible and won’t try to enter in the first place.</li>\n<li>Doors that are locked will persist between raids.</li>\n<li>Doors must be closed and unlocked in order to be locked by you. If you unlock a door with a key such as marked room, then lock it again, it will work but will not persist in the next raid and will not count towards your locked limits in the next raid unless re-locked.</li>\n<li>run unlock_all_player_locked_doors command in ‘~’ console to unlock all player locked doors on the map you are currently on.</li>\n<li>Door Randomizer compatible.\n<ul>\n<li>Any door that is randomly opened will lose it’s locked state and not count towards your locked limits unless re-locked.</li>\n</ul>\n</li>\n<li>Fika compatible.</li>\n</ul>\n<p><strong>Balance:</strong></p>\n<ul>\n<li>Number of doors you are allowed to lock per map limited.</li>\n<li>Both the number of doors per map, as well as the entire limit system itself can be tweaked in the F12 config menu.</li>\n</ul>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "~3.10.0", "content_length": null, "downloads": 466, "published_at": "2024-12-28T23:44:37.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1923/lockable-doors/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.0.1", "spt_version_constraint": "~3.10.0", "content_length": null, "downloads": 328, "published_at": "2024-12-30T21:22:25.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1923/lockable-doors/1.0.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.0.2", "spt_version_constraint": "~3.10.0", "content_length": null, "downloads": 1006, "published_at": "2024-12-31T20:44:34.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1923/lockable-doors/1.0.2", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.0", "spt_version_constraint": "~3.10.0", "content_length": null, "downloads": 1624, "published_at": "2025-01-21T15:12:25.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1923/lockable-doors/1.1.0", "github_url": null, "e