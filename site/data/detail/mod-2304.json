heads/SPT-3.11/Showcase%20Pictures/Neon%20Sign%20-%20Onii.png\" alt=\"Neon Sign - Onii\" /> <img loading=\"lazy\" decoding=\"async\" src=\"https://raw.githubusercontent.com/Drexira/DragonDen-NeonSigns/refs/heads/SPT-3.11/Showcase%20Pictures/Neon%20Sign%20-%20Rose%20Heart.png\" alt=\"Neon Sign - Rose Heart\" /> <img loading=\"lazy\" decoding=\"async\" src=\"https://raw.githubusercontent.com/Drexira/DragonDen-NeonSigns/refs/heads/SPT-3.11/Showcase%20Pictures/Neon%20Sign%20-%20Sailor%20Moon%20Cat.png\" alt=\"Neon Sign - Sailor Moon Cat\" /> <img loading=\"lazy\" decoding=\"async\" src=\"https://raw.githubusercontent.com/Drexira/DragonDen-NeonSigns/refs/heads/SPT-3.11/Showcase%20Pictures/Neon%20Sign%20-%20Sailor%20Moon%20Girl.png\" alt=\"Neon Sign - Sailor Moon Girl\" /> <img loading=\"lazy\" decoding=\"async\" src=\"https://raw.githubusercontent.com/Drexira/DragonDen-NeonSigns/refs/heads/SPT-3.11/Showcase%20Pictures/Neon%20Sign%20-%20Skulls.png\" alt=\"Neon Sign - Skulls\" /></p></div></div>\n<div id=\"tabset-1-panel-3\" class=\"tab-panel\"><div class=\"tab-title\">Installation</div>\n<div class=\"tab-content\"><p>Unpack the zip and drop the user folder into your SPTarkov root.</p>\n<p>(Use 7Zip <a target=\"_blank\" class=\"external-link\" href=\"https://www.7-zip.org/\" rel=\"noreferrer noopener\">Here</a>)</p>\n<p>Install demo video (credit to Drakia):</p>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/vKRw58b.gif\" alt=\"Demonstration\" /></p></div></div>\n<div id=\"tabset-1-panel-4\" class=\"tab-panel\"><div class=\"tab-title\">Known Issues</div>\n<div class=\"tab-content\"><p>None that I know of.</p></div></div>\n<div id=\"tabset-1-panel-5\" class=\"tab-panel\"><div class=\"tab-title\">Credits</div>\n<div class=\"tab-content\"><p><strong>Welcome to Tarkov</strong> (WTT) for: Mod framework and helping me</p>\n<p><strong>Drakia</strong> for: The install video</p></div></div>\n<div id=\"tabset-1-panel-6\" class=\"tab-panel\"><div class=\"tab-title\">What is Dragon Den</div>\n<div class=\"tab-content\"><p><strong>Dragon Den</strong> is my twist on Tarkov. It’s where cuteness, edgyness, and weirdness all collide, while still keeping things believable.</p>\n<ul>\n<li>Traders with their own quirks and attitude</li>\n<li>Custom items and quests that feel fresh</li>\n<li>Backpacks, armor, facewear and headwear with personality</li>\n<li>Odd creations that shouldn’t exist… but somehow fit right in</li>\n</ul>\n<p>No weapons, just everything else that makes Tarkov less boring.</p>\n<p>Want to reach me? Look for #drexiras-dragon-den in <a target=\"_blank\" class=\"external-link\" href=\"https://discord.gg/WelcomeToTarkov\" rel=\"noreferrer noopener\">Welcome To Tarkov’s Discord</a></p></div></div></div>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 1461, "published_at": "2025-09-11T20:51:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2304/dragon-den-neon-signs/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "2.0.0", "spt_version_constraint": "~4.0 <4.1.0", "content_length": 12381300, "downloads": 5887, "published_at": "2025-11-07T06:26:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2304/dragon-den-neon-signs/2.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": [{"id": 2310, "name": "WTT - CommonLib", "slug": "wtt-commonlib", "status": "ok"}]}], "repos": ["Drexira/DragonDen-NeonSigns"], "source_code_links": [{"url": "https://github.com/Drexira/DragonDen-NeonSigns", "label": "Source"}], "required_by": 0, "no_repo": false, "obtainable": true, "dep_problems": 0}