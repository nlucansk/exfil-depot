{"kind": "addon", "id": 94, "name": "NORVAIR (Ground Zero)", "slug": "norvair-ground-zero", "teaser": "Opens up the NORVAIR store, with lots of loot potential.", "owner_name": "shaneeexd", "downloads": 307, "favourites": 0, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": null, "guid": null, "thumbnail_local": null, "category": null, "category_id": null, "updated_at": "2026-08-07T18:02:27.000000Z", "created_at": "2026-07-28T03:47:14.000000Z", "published_at": "2026-07-28T03:11:00.000000Z", "latest_constraint": null, "latest_version": "1.1.0", "has_local": false, "has_github": false, "license_link": null, "description_html": "<p>This addon opens up the NORVAIR store on ground zero - it requires a new key to open.</p>\n<p>Lots of loot spawns/containers/objects are inside, so the key is costly, but can be found in vanilla containers, as well as a couple of dedicated rare loose key spawns near the store.</p>\n<p>There is also a key for the cash register.</p>\n<h2>Images</h2>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://github.com/ShaneeexD/SPT-NORVAIR/blob/main/after1.png?raw=true\" alt=\"3N6gTe2.gif\" />\n<img loading=\"lazy\" decoding=\"async\" src=\"https://github.com/ShaneeexD/SPT-NORVAIR/blob/main/after2.png?raw=true\" alt=\"3N6gTe2.gif\" />\n<img loading=\"lazy\" decoding=\"async\" src=\"https://github.com/ShaneeexD/SPT-NORVAIR/blob/main/after3.png?raw=true\" alt=\"3N6gTe2.gif\" /></p>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": null, "content_length": 37548, "downloads": 161, "published_at": "2026-07-28T03:54:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/addon/download/94/norvair-ground-zero/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": null, "dependencies": []}, {"version": "1.0.1", "spt_version_constraint": null, "content_length": 73409, "downloads": 55, "published_at": "2026-08-07T16:01:00.000000Z", "forge_link"