{"kind": "mod", "id": 2656, "name": "Quick Loot", "slug": "quick-loot", "teaser": "a mod that loots items with a press of a key!", "owner_name": "20fpsguy", "downloads": 2387, "favourites": 6, "featured": false, "contains_ads": false, "contains_ai_content": true, "cheat_notice": false, "license_name": "MIT License", "guid": "com.20fpsguy.quickloot", "thumbnail_local": null, "category": "Other", "category_id": 17, "updated_at": "2026-07-31T22:42:24.000000Z", "created_at": "2026-04-04T19:21:53.000000Z", "published_at": "2026-04-04T19:28:00.000000Z", "latest_constraint": "4.0.13", "latest_version": "1.0.6", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<p>Tired of manually picking through a scav’s pockets for ammo and meds? QuickLoot lets you grab exactly what you need with a single keypress.</p>\n<p>Open a body or container, press your hotkey, and the mod automatically transfers matching items straight to your inventory. No dragging, no clicking, just loot and go.</p>\n<div class=\"tabset\"><div id=\"tabset-1-panel-1\" class=\"tab-panel\"><div class=\"tab-title\">Features</div>\n<div class=\"tab-content\"><p><strong>Auto Search</strong></p>\n<p><strong>Quick sort</strong> sorts items only in the backpack from top to bottom  (default: G)</p>\n<p><strong>Configurable hotkey</strong> (default: F)</p>\n<p><strong>Category filters</strong> - choose what to auto-loot: Ammo, Meds, Food &amp; Drink, Barter items</p>\n<p><strong>High value filter</strong> - automatically grabs expensive items based on live flea market prices <em>(will be expanded in a future addon)</em></p>\n<p>All settings are available in the F12 BepInEx menu in-game.</p></div></div></div>\n\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "4.0.13", "content_length": 14502, "downloads": 81, "published_at": "2026-04-04T19:28:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2656/quick-loot/1.0.0", "gi