{"kind": "mod", "id": 1439, "name": "Urusai-ren", "slug": "urusai-ren", "teaser": "I hate the Reserve siren. So I hired a rat to chew off its wiring.", "owner_name": null, "downloads": 2390, "favourites": 0, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "MIT License", "guid": null, "thumbnail_local": null, "category": null, "category_id": null, "updated_at": "2026-07-07T16:58:57.000000Z", "created_at": "2024-05-27T05:31:30.000000Z", "published_at": "2024-05-27T05:31:30.000000Z", "latest_constraint": "~3.10.0", "latest_version": "3.10.0", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<p>This plugin will make it so the Reserve siren only blares three times when the hermetic switch is pulled, and blare once after the switch expires.</p>\n<p>You can configure how many times the siren is allowed to play in the BepInEx (F12) config menu after turning on <em>Advanced Settings.</em></p>\n<p><em>Also a thank you to Arys for helping me find the siren game object. Would’ve never thought about using Unity Explorer.</em></p>\n", "versions": [{"version": "3.8.3", "spt_version_constraint": "3.8.3", "content_length": null, "downloads": 731, "published_at": "2024-05-27T05:31:30.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1439/urusai-ren/3.8.3", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "3.9.0", "spt_version_constraint": "3.9.0", "content_length": null, "downloads": 989, "published_at": "2024-07-07T19:43:58.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1439/urusai-ren/3.9.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "3.10.0", "spt_version_constraint": "~3.10.0", "content_length": null, "downloads": 670, "published_at": "2024-12-19T18: