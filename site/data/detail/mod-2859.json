{"kind": "mod", "id": 2859, "name": "Compatibility Highlighter", "slug": "compatibility-highlighter", "teaser": "Highlight compatible mags ammo and attachments.", "owner_name": "awnova", "downloads": 4154, "favourites": 31, "featured": false, "contains_ads": false, "contains_ai_content": true, "cheat_notice": false, "license_name": "MIT License", "guid": "com.awnova.compatibilityhighlighter", "thumbnail_local": null, "category": "Other", "category_id": 17, "updated_at": "2026-08-06T15:54:03.000000Z", "created_at": "2026-07-31T13:49:31.000000Z", "published_at": "2026-07-31T13:52:00.000000Z", "latest_constraint": "~4.1.", "latest_version": "1.2.0", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<h2>What it does:</h2>\n<ul>\n<li>Shows all items compatible with the hovered item in both directions</li>\n<li>Hover over ammo → compatible magazines and guns light up</li>\n<li>Hover over a magazine → compatible guns and ammo light up</li>\n<li>Hover over a gun → compatible attachments, ammo, and magazines light up</li>\n</ul>\n<h2>Key features:</h2>\n<ul>\n<li>Configurable highlight color (default: green)</li>\n<li>Adjustable hover delay before the highlight appears</li>\n<li>Can toggle container items (backpacks, rigs, cases) on or off</li>\n<li>Option to use vanilla highlighting when you’re actively dragging items</li>\n</ul>\n<h2>Credits</h2>\n<p>Inspired by <a target=\"_blank\" class=\"external-link\" href=\"https://forge.sp-tarkov.com/mod/2823/acs-attachment-compatibility-highlight\" rel=\"noreferrer noopener\">AC’s - Attachment Compatibility Highlight</a>.</p>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "~4.0.13", "content_length": 9079, "downloads": 341, "published_at": "2026-07-31T13:50:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2859/compatibility-highlighter/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility"