{"kind": "mod", "id": 2564, "name": "Restricted Flea", "slug": "restricted-flea", "teaser": "Restrict what's available on the flea based on item categories. Can also disable selling to the flea.", "owner_name": "Mattdokn", "downloads": 1554, "favourites": 2, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": null, "guid": "com.mattdokn.restrictedflea", "thumbnail_local": null, "category": "Other", "category_id": 17, "updated_at": "2026-07-28T07:57:10.000000Z", "created_at": "2026-01-26T16:42:10.000000Z", "published_at": "2026-01-26T16:26:00.000000Z", "latest_constraint": "~4.0 <4.1.0", "latest_version": "1.0.1", "has_local": false, "has_github": false, "license_link": null, "description_html": "<h1>Restricted Flea</h1>\n<ul>\n<li>Restrict what’s available on flea based on category</li>\n<li>Disable selling to the flea</li>\n<li>Remove default blacklist</li>\n</ul>\n<h1>Whitelist works on parent categories as well as direct item IDs.</h1>\n<p>The default config only allows you to buy:</p>\n<ul>\n<li>Barter Items</li>\n<li>Keys</li>\n<li>Weapons</li>\n<li>Attachments</li>\n<li>Food &amp; Drink</li>\n<li><em>Other</em></li>\n<li><em>Info</em></li>\n</ul>\n<h2>Also disables selling to flea and removes the default flea blacklist.</h2>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "~4.0 <4.1.0", "content_length": 7796, "downloads": 67, "published_at": "2026-01-26T16:45:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2564/restricted-flea/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": []}, {"version": "1.0.1", "spt_version_constraint": "~4.0 <4.1.0", "content_length": 7398, "downloads": 1487, "published_at": "2026-01-26T19:20:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2564/restricted-flea/1.0.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility"