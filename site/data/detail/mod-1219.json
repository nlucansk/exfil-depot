{"kind": "mod", "id": 1219, "name": "SP-EFT Manager", "slug": "sp-eft-manager", "teaser": "Simplify mod installations", "owner_name": "Schrader", "downloads": 124333, "favourites": 46, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "GNU GPLv3", "guid": "com.schrader.sptarkovclient", "thumbnail_local": null, "category": "Tools", "category_id": 1, "updated_at": "2026-07-28T09:41:11.000000Z", "created_at": "2024-01-10T15:59:04.000000Z", "published_at": "2026-04-07T05:57:00.000000Z", "latest_constraint": "~4 <4.1.0", "latest_version": "0.4.5", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/gpl-3.0/", "description_html": "<p>The primary goal is the automation of the mod process — covering the stages of searching, downloading and installing— for a more efficient experience.</p>\n<div class=\"tabset\"><div id=\"tabset-1-panel-1\" class=\"tab-panel\"><div class=\"tab-title\">Description</div>\n<div class=\"tab-content\"><p>Current Feature</p>\n<ul>\n<li>Ability to seek out and integrate multiple SP-Tarkov instances</li>\n<li>Change the mod load order</li>\n<li>Search for mods</li>\n<li>Support of direct downloads (from GitHub, Dropbox, direct Download, Google Drive, MegaNz)</li>\n<li>Automated download and installation process</li>\n<li>Light and Dark theme</li>\n<li>Includes a Top-Rated section showcasing the most recommended mods</li>\n<li>(SP-EFT Manager) Automated updates for new releases, directly from GitHub</li>\n<li>Extension of pages and incorporation of pagination from the SP-Tarkov Hub</li>\n</ul>\n<p>Experimental Features:</p>\n<ul>\n<li>Start server</li>\n<li>Enable / Disable installed mods — Thanks to <a target=\"_blank\" class=\"external-link\" href=\"https://hub.sp-tarkov.com/user/48178-glo/\" rel=\"noreferrer noopener\">glo</a></li>\n</ul>\n<p>Planned Features:</p>\n<ul>\n<li>Start launcher</li>\n<li>Basic version verification feature for instances and mods</li>\n<li>‘Checking for new version’ functionality</li>\n<li>‘Preinstall Check’ for a smoother installation process</li>\n<li>‘Revert-Changes’ functionality</li>\n<li>Remove installed mods</li>\n<li>and more …</li>\n</ul></div></div>\n<div id=\"tabset-1-panel-2\" class=\"tab-panel\"><div class=\"tab-title\">Support</div>\n<div class=\"tab-content\"><p><strong><em>For questions or help, you can contact me from the official SP-Pub Discord</em> <em>→ _schrader</em></strong></p>\n<p>Path to the logs:<em><strong>%APPDATA%\\sp-tarkov-client\\logs\\</strong></em></p>\n<p>If you encounter any issues during the installation steps, please submit an issue and include the link to the mod in question for further investigation and resolution.</p></div></div>\n<div id=\"tabset-1-panel-3\" class=\"tab-panel\"><div class=\"tab-title\">Contributors</div>\n<div class=\"tab-content\"><p>Special thanks to all contributors:</p>\n<ul>\n<li>Markosz</li>\n</ul></div></div></div>\n", "versions": [{"version": "0.2.7", "spt_version_constraint": "3.8.0", "content_length": null, "downloads": 492, "published_at": "2024-04-02T06:31:49.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1219/sp-eft-manager/0.2.7", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "0.2.15", "spt_version_constraint": "3.9.0", "content_length": null, "downloads": 1211, "published_at": "2024-07-10T17:37:17.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1219/sp-eft-manager/0.2.15", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "0.3.2", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 19600, "published_at": "2025-02-23T20:14:10.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1219/sp-eft-manager/0.3.2", "github_url": null, "external_url": null, "local_path": null, "fika_compatibil