et accessories, and ammunition.</li>\n</ul>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://cdn.discordapp.com/attachments/336226931085279233/1442689400978014270/rarities1.png?ex=692658b5&amp;is=69250735&amp;hm=dfd9cab2b92db23a7d3f83b6725024502cc069809b617e9a24cade99e5a1a575&amp;\" alt=\"r1\" /></p>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://cdn.discordapp.com/attachments/336226931085279233/1442689401594581064/rarities2.png?ex=692658b5&amp;is=69250735&amp;hm=7dc8e1301248db2ae6fbb386aeb1c86988d3b7516055655c4f3f3bb93eac454c&amp;\" alt=\"r2\" /></p>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://cdn.discordapp.com/attachments/336226931085279233/1442689401988579339/rarities3.png?ex=692658b5&amp;is=69250735&amp;hm=30c3de9a7c97e8f14c14d199e6e1a451ca8ee9be63112653971064b444f83682&amp;\" alt=\"r3\" /></p>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://cdn.discordapp.com/attachments/336226931085279233/1442689402341036092/rarities4.png?ex=692658b5&amp;is=69250735&amp;hm=6ba3fd09062acac03e8f315d124e182842d05a125347d25cada69b7a75a71184&amp;\" alt=\"r4\" /></p>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 817, "published_at": "2025-11-25T02:09:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2466/rarities/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": [{"id": 1090, "name": "Color Converter API", "slug": "color-converter-api", "status": "ok"}]}], "repos": ["navysealclubber/Rarities"], "source_code_links": [{"url": "https://github.com/navysealclubber/Rarities", "label": ""}], "required_by": 0, "no_repo": false, "obtainable": true, "dep_problems": 0}