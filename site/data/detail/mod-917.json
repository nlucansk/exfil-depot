{"kind": "mod", "id": 917, "name": "Two Slot Extended Mags", "slug": "two-slot-extended-mags", "teaser": "Makes 40-45 round extended mags only take 2 slots in the inventory instead of 3!", "owner_name": "Platinum", "downloads": 52153, "favourites": 0, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "GNU GPLv3", "guid": null, "thumbnail_local": null, "category": null, "category_id": null, "updated_at": "2026-07-13T18:08:29.000000Z", "created_at": "2023-06-11T07:14:15.000000Z", "published_at": "2023-06-11T07:14:15.000000Z", "latest_constraint": "~3.11.0", "latest_version": "1.0.5+b", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/gpl-3.0/", "description_html": "<p>Finally making them a more viable option before getting quad stack 60 rounders.</p>\n<p>Also prevents the base gun from being an extra row taller in the inventory when an extended mag is inserted.</p>\n<p>If you want the 100 round STANAG to also be 2 slots tall, set config.json -&gt; maxMagazineCapacityToBeIncluded to 100.</p>\n<p><strong>Installation:</strong></p>\n<p>Copy contents of zip file to &lt;spt-dir&gt;/user/mods.</p>\n<p><strong>Also clean Temp files using the Aki.Launcher settings in the top right to get updated icons for the new slot size!</strong></p>\n", "versions": [{"version": "1.0.2", "spt_version_constraint": "~3.7.0", "content_length": null, "downloads": 6583, "published_at": "2023-10-09T09:25:38.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/917/two-slot-extended-mags/1.0.2", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.0.3", "spt_version_constraint": "3.8.0", "content_length": null, "downloads": 9520, "published_at": "2024-04-03T09:23:02.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/917/two-slot-extended-mags/1.0.3", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.0.4", "spt_version_constraint": "~3.9.0", "content_length": null, "downloads": 13021, "published_at": "2024-08-05T10:46:36.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/917/two-slot-extended-mags/1.0.4", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.0.5+b", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 17713, "published_at": "2025-03-21T10:17:09.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/917/two-slot-extended-mags/1.0.5+b", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}], "repos": ["gndworks/spt-2-slot-mags"], "source_code_links": [{"url": "https://github.com/gndworks/spt-2-slot-mags", "label": ""}], "required_by": 0, "no_repo": false, "obtainable": true, "dep_problems": 0}