{"kind": "mod", "id": 2608, "name": "Smajlec's Stamina", "slug": "smajlecs-stamina", "teaser": "When you cannot sprint anymore, jog!", "owner_name": "Smajlec", "downloads": 6491, "favourites": 23, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "MIT License", "guid": "com.smajlec.stamina", "thumbnail_local": null, "category": "Other", "category_id": 17, "updated_at": "2026-07-28T08:25:26.000000Z", "created_at": "2026-02-27T13:00:08.000000Z", "published_at": "2026-02-27T13:06:00.000000Z", "latest_constraint": "~4.0 <4.1.0", "latest_version": "1.3.0", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<p>This mod allows you to run indefinitely. When stamina is depleted, your character slows down to a jogging pace, similar to how it works in Squad.</p>\n<p>It also lowers the stamina requirement for jumping and vaulting, allowing you to get over obstacles with just a pixel of stamina. You will no longer be staring at a road barrier for 20 seconds waiting for stamina to regenerate.</p>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "~4.0 <4.1.0", "content_length": 4413, "downloads": 324, "published_at": "2026-02-27T13:02:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2608/smajlecs-stamina/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": []}, {"version": "1.1.0", "spt_version_constraint": "~4.0 <4.1.0", "content_length": 4661, "downloads": 194, "published_at": "2026-02-28T15:22:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2608/smajlecs-stamina/1.1.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": []}, {"version": "1.2.0", "spt_version_constraint": "~4.0 <4.1.0", "content_length": 4849, "downloads": 2220, "published_at": "2026-03-01T09:34:00