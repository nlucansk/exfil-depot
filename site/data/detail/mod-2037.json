{"kind": "mod", "id": 2037, "name": "Colored Tracers", "slug": "colored-tracers", "teaser": "Bullets now have tracers colored by their penetration value!", "owner_name": "Szonszczyk", "downloads": 11311, "favourites": 11, "featured": false, "contains_ads": false, "contains_ai_content": true, "cheat_notice": false, "license_name": "MIT License", "guid": "com.szonszczyk.coloredtracers", "thumbnail_local": null, "category": "Scripting", "category_id": 3, "updated_at": "2026-08-09T18:02:46.000000Z", "created_at": "2025-03-16T23:58:08.000000Z", "published_at": "2025-03-16T23:58:00.000000Z", "latest_constraint": "~4.1.2", "latest_version": "3.0.1", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<p><em>In the heat of battle, quickly determine who poses the real threat. Red tracers from the right - just Scavs. Green tracers from the left - PMCs. But from the center, someone is firing violet tracers at you… It’s clearly Birdeye.</em></p>\n<p><em>You don’t even need to see your enemies - just a split second, and you already know everything. Now you can plan accordingly… This raid is yours to win!</em></p>\n<h2><strong>Features</strong></h2>\n<ul>\n<li>Coloring tracers:\n<ul>\n<li>Based on either bullet damage or penetration</li>\n<li>With linear rainbow color scale (red-worst, violet-best)</li>\n<li>With 7-steps color profile with rainbow or customizable colors</li>\n<li>Single color that can be added based on bullet category</li>\n</ul>\n</li>\n<li>Option to invert scales (violet-worst, red-best)</li>\n<li>Option to color bullet to random color</li>\n</ul>\n<p><strong>Choose your preferred mode in the config file</strong></p>\n<div class=\"tabset\"><div id=\"tabset-1-panel-1\" class=\"tab-panel\"><div class=\"tab-title\">Screenshots</div>\n<div class=\"tab-content\"><p><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/1DIeiMf.png\" alt=\"1DIeiMf.png\" /></p>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/cVsWen9.png\" alt=\"cVsWen9.png\" /></p>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/C27Sgbu.png\" alt=\"C27Sgbu.png\" /></p></div></div>\n<div id=\"tabset-1-panel-2\" class=\"tab-panel\"><div class=\"tab-title\">Rainbow Color Scale</div>\n<div class=\"tab-content\"><p>The mod uses a rainbow scale to represent bullet values:</p>\n<p>Red → lowest value</p>\n<p>Orange / Yellow / Green / Blue → average value</p>\n<p>Violet → strongest value</p>\n<p>This allows you to instantly judge ammo performance just by looking at tracer color!</p></div></div>\n<div id=\"tabset-1-panel-3\" class=\"tab-panel\"><div class=\"tab-title\">Compatibility</div>\n<div class=\"tab-content\"><ul>\n<li>Compatible with all mods that add new bullets or calibers</li>\n<li>Realism compatibility is planned for a future update</li>\n</ul></div></div></div>\n", "versions": [{"version": "1.1.0", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 268, "published_at": "2025-08-19T12:51:58.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2037/colored-tracers/1.1.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.1", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 1484, "published_at": "2025-08-19T23:01:04.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2037/colored-tracers/1.1.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "2.0.0", "spt_version_constraint": "~4.0.0", "content_length": 10796, "downloads": 2382, "published_at": "2025-10-21T13:33:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2037/colored-tracers/2.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": [{"id": 1090, "name": "Color Con