{"kind": "mod", "id": 2586, "name": "Caliber Under Ammo Name", "slug": "caliber-under-ammo-name", "teaser": "Adds a caliber label below the short name for ammo & ammo boxes.", "owner_name": "xvotex", "downloads": 14839, "favourites": 46, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": null, "guid": "com.slpf.caliberundername", "thumbnail_local": null, "category": "Other", "category_id": 17, "updated_at": "2026-08-06T02:14:26.000000Z", "created_at": "2026-02-12T12:30:13.000000Z", "published_at": "2026-02-12T12:30:00.000000Z", "latest_constraint": "~4.1.0", "latest_version": "1.2.0", "has_local": false, "has_github": false, "license_link": null, "description_html": "<h3><strong>Adds a caliber label below the short name for ammo &amp; ammo boxes.</strong></h3>\n<p>It also adds caliber labels to weapons, magazines, in-raid items, along with <a target=\"_blank\" class=\"external-link\" href=\"https://forge.sp-tarkov.com/mod/2521/amands-sense-updated\" rel=\"noreferrer noopener\">AmandsSense</a> support, alternative ammo sorting, and show names in trading.<br />\nIt’s easier to check in the settings - you can turn off everything you don’t need.</p>\n<h3><strong>Show Names in Trading:</strong></h3>\n<p>Hold a key at a trader to show item names instead of prices.<br />\nDefault: <strong>Left Alt</strong>. Containers are not supported.</p>\n<h3><strong>Ammo Sorting:</strong></h3>\n<p>Added primary and secondary sorting with ascending/descending selection.<br />\nTertiary sorting is always alphabetical.  Sorting also applies to traders.</p>\n<p>Sort modes:</p>\n<ul>\n<li><strong>Caliber</strong> - sort by caliber type</li>\n<li><strong>Alphabetical</strong> - sort by ammo name</li>\n<li><strong>Count</strong> - sort by ammo/box count</li>\n<li><strong>Rarity</strong> - sort by rarity from <a target=\"_blank\" class=\"external-link\" href=\"https://forge.sp-tarkov.com/mod/2430/odts-item-info-spt-40\" rel=\"noreferrer noopener\">Item Info</a> (can be changed in advanced mode)</li>\n<li><strong>Damage</strong> -  sort by ammo damage value</li>\n<li><strong>Penetration</strong> -  sort by ammo penetration power</li>\n</ul>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "~4.0.0", "content_length": 11996, "downloads": 415, "published_at": "2026-02-12T12:31:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2586/caliber-under-ammo-name/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.0.1", "spt_version_constraint": "~4.0.0", "content_length": 11965, "downloads": 377, "published_at": "2026-02-13T08:11:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2586/caliber-under-ammo-name/1.0.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.0", "spt_version_constraint": "~4.0.0", "content_length": 15536, "downloads": 86, "published_at": "2026-02-14T08:26:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2586/caliber-under-ammo-name/1.1.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.1", "spt_version_constraint": "~4.0.0", "content_length": 15574, "downloads": 566, "published_at": "2026-02-14T09:41:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2586/caliber-under-ammo-name/1.1.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.2", "spt_version_constraint": "~4.0.0", "content_length": 18274, "downloads": 96, "published_at": "2026-02-16T16:49:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2586/caliber-under-ammo-name/1.1.2", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": 