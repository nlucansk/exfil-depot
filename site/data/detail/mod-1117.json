{"kind": "mod", "id": 1117, "name": "Deminvincibility", "slug": "deminvincibility", "teaser": "A standalone version of DadGamerMode's Keep 1 Health section with extended settings.", "owner_name": "Devraccoon", "downloads": 55756, "favourites": 40, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "MIT License", "guid": "com.hazelify.deminvincibility", "thumbnail_local": null, "category": "Scripting", "category_id": 3, "updated_at": "2026-07-28T06:15:33.000000Z", "created_at": "2023-10-18T09:18:59.000000Z", "published_at": "2023-10-18T09:18:00.000000Z", "latest_constraint": "~3.11.0", "latest_version": "2.0.0", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<p>A simple mod that keeps you from dying but still lets you take damage. Excellent for practicing the various kinds of meds that Tarkov offers. Has extended settings.</p>\n<h3>Current features</h3>\n<ul>\n<li>Keep 1 Health, meaning you can lose all health but will still retain the last hp left on the affected bodypart.</li>\n<li>Selection (Head, Thorax, Head &amp; Thorax, All), for choosing which parts of your body will retain the last hp and what can get blacked.</li>\n<li>Ignoring health side effects, where fractures, bleeds, etc. will self-heal.</li>\n<li>% Damage received, which means you will take X% of whatever damage you actually take.</li>\n<li>Second chance protection, where the first killshot or killnade in any given raid can give you a second chance to survive and escape alive.</li>\n</ul>\n<h3>Installation</h3>\n<ol>\n<li>Download the zip from the big blue button</li>\n<li>Open the archived zip</li>\n<li>Drag-and-drop the <strong>BepInEx</strong> folder into your <em>main SPT folder</em> (where Aki.Server.exe is located)</li>\n<li>Profit</li>\n</ol>\n<p><a target=\"_blank\" class=\"external-link\" href=\"https://i.imgur.com/vKRw58b.gif\" rel=\"noreferrer noopener\"><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/vKRw58b.gif\" alt=\"vKRw58b.gif\" /></a></p>\n<h3>Support</h3>\n<p>As usual, always available on Discord:</p>\n<ul>\n<li><strong>net.hazelify</strong> or or the <a target=\"_blank\" class=\"external-link\" href=\"https://discord.com/invite/Xn9msqQZan\" rel=\"noreferrer noopener\">SPT-AKI Discord server</a></li>\n</ul>\n", "versions": [{"version": "1.4.1", "spt_version_constraint": "3.8.0", "content_length": null, "downloads": 4124, "published_at": "2024-04-01T21:16:15.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1117/deminvincibility/1.4.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.5.0", "spt_version_constraint": "3.9.0", "content_length": null, "downloads": 4201, "published_at": "2024-07-06T22:58:45.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1117/deminvincibility/1.5.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.6.0", "spt_version_constraint": "3.10.0", "content_length": null, "downloads": 7059, "published_at": "2024-11-26T16:57:56.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1117/deminvincibility/1.6.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.7.0", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 10698, "published_at": "2025-03-21T23:02:43.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1117/deminvincibility/1.7.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.8.0", "spt_version_constraint": "~4.0.0", "content_length": 9029, "downloads": 1339, "published_at": "2025-10-12T20:49:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download