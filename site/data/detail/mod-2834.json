{"kind": "mod", "id": 2834, "name": "Ultimate Trader Assort Editor", "slug": "ultimate-trader-assort-editor", "teaser": "An in depth trader assort editor", "owner_name": "GoatBoy", "downloads": 937, "favourites": 12, "featured": false, "contains_ads": false, "contains_ai_content": true, "cheat_notice": false, "license_name": "MIT License", "guid": "com.goatboy.ultimate-trader-assort-editor", "thumbnail_local": null, "category": "Tools", "category_id": 1, "updated_at": "2026-07-30T23:40:32.000000Z", "created_at": "2026-07-20T23:26:26.000000Z", "published_at": "2026-07-20T23:30:00.000000Z", "latest_constraint": "4.0.13", "latest_version": "1.0.3", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<h2>Ultimate Trader Assort Editor</h2>\n<p>Ultimate Trader Assort Editor is an in game trader assortment editor for SPT. It lets you add, remove, and edit trader listings directly from the trader screen.</p>\n<p>The editor is built from cloned Tarkov UI elements and keeps its appearance and behavior close to the original in game UI.</p>\n<h2>Features</h2>\n<ul>\n<li>Add items and weapon presets to trader assortments.</li>\n<li>Modify existing trader listings.</li>\n<li>Remove listings and restore previously removed listings.</li>\n<li>Change loyalty level requirements.</li>\n<li>Configure currency prices, multi-currency prices, and item barters.</li>\n<li>Change trader stock and per-profile purchase limits, including unlimited values.</li>\n<li>Edit supported weapons, armor, helmets, and their attachments.</li>\n<li>Supports modded items and custom traders.</li>\n<li>Refreshes trader stock and instantly shows offers on the flea market.</li>\n<li>Saves changes as JSON files that can be shared or manually edited.</li>\n<li>Loads multiple <code>add.json</code> and <code>remove.json</code> edit packs for each trader to allow users to share their changes.</li>\n<li>Allows the <code>EDIT ASSORTS</code> button to be hidden through the F12 menu.</li>\n</ul>\n<h2>Installation</h2>\n<p>Drag the BepInEx and SPT folders directly into your SPT root install.</p>\n<h2>Showcase</h2>\n<p><a target=\"_blank\" class=\"external-link\" href=\"https://i.imgur.com/lQrdNP8.png\" rel=\"noreferrer noopener\"><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/lQrdNP8.png\" alt=\"UTAE Showcase 1\" /></a>\n<a target=\"_blank\" class=\"external-link\" href=\"https://i.imgur.com/IuyVUbw.png\" rel=\"noreferrer noopener\"><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/IuyVUbw.png\" alt=\"UTAE Showcase 2\" /></a>\n<a target=\"_blank\" class=\"external-link\" href=\"https://i.imgur.com/Yl13aov.png\" rel=\"noreferrer noopener\"><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/Yl13aov.png\" alt=\"UTAE Showcase 3\" /></a>\n<a target=\"_blank\" class=\"external-link\" href=\"https://i.imgur.com/OErGzVE.png\" rel=\"noreferrer noopener\"><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/OErGzVE.png\" alt=\"UTAE Showcase 4\" /></a>\n<a target=\"_blank\" class=\"external-link\" href=\"https://i.imgur.com/M8YCAbY.png\" rel=\"noreferrer noopener\"><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/M8YCAbY.png\" alt=\"UTAE Showcase 5\" /></a></p>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "4.0.13", "content_length": 132532, "downloads": 96, "published_at": "2026-07-20T23:30:19.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2834/ultimate-trader-assort-editor/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.0.1", "spt_version_constraint": "4.0.13", "content_length": 133341, "downloads": 153, "published_at": "2026-07-21T03:47:34.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2834/ultimate-trader-assort-editor/1.0.1", "github_url": null, "external_url": null, "local_path": null, "fik