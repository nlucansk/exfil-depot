{"kind": "mod", "id": 2522, "name": "EpicShaderTime", "slug": "epicshadertime", "teaser": "Dependency for custom shaders", "owner_name": "EpicRangeTime", "downloads": 38630, "favourites": 42, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "Creative Commons BY-NC-SA 4.0", "guid": "com.epicrangetime.shaders", "thumbnail_local": null, "category": "Tools", "category_id": 1, "updated_at": "2026-07-29T04:56:18.000000Z", "created_at": "2025-12-30T00:55:13.000000Z", "published_at": "2026-07-29T04:56:00.000000Z", "latest_constraint": "~4.0.0", "latest_version": "1.0.1", "has_local": false, "has_github": false, "license_link": "http://creativecommons.org/licenses/by-nc-sa/4.0/legalcode", "description_html": "<p>Starting 14 February 2026, this is an editor tool only and not a dependency mod.\nI am leaving the versions available so that the mod is still available for the mods that need it but there will be no further versions published.</p>\n<p>The way to properly use this package is to download the .unitypackage file from the github and import it into your unity 2022 project.</p>\n<p>You may either have the shaders build directly into your bundles or you may designate a dependency bundle for the shaders you use to build into, if you know how to designate bundle dependencies in your bundles.json</p>\n<p>All I ask is that you credit me if you use these shaders, thank you.</p>\n<p>If you need any help using this package please contact me in the <a target=\"_blank\" class=\"external-link\" href=\"https://discord.gg/Nz6VX78xRa\" rel=\"noreferrer noopener\">WTT Discord</a>.</p>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "~4.0 <4.1.0", "content_length": 87501, "downloads": 190, "published_at": "2025-12-30T03:59:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2522/epicshadertime/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": []}, {"version": "1.0.1", "spt_version_constraint": "~4.0.0", "content_length": 87401, "downloads": 38440, "published_at": "2025-12-30T09:22:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2522/epicshadertime/1.0.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": []}], "repos": ["EpicRangeTime/Epic_Shaders"], "source_code_links": [{"url": "https://github.com/EpicRangeTime/Epic_Shaders?tab=readme-ov-file", "label": "Github"}], "required_by": 2, "no_repo": false, "obtainable": true, "dep_problems": 0}