{"kind": "mod", "id": 1343, "name": "Skipper", "slug": "skipper", "teaser": "A small client mod for conveniently skipping quests", "owner_name": "Terkoiz", "downloads": 306765, "favourites": 244, "featured": true, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "University of Illinois/NCSA Open Source License", "guid": "com.terkoiz.skipper", "thumbnail_local": null, "category": "Other", "category_id": 17, "updated_at": "2026-08-09T22:57:03.000000Z", "created_at": "2024-04-19T15:27:58.000000Z", "published_at": "2024-04-19T15:27:00.000000Z", "latest_constraint": "~4.1", "latest_version": "1.1.5", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/ncsa/", "description_html": "<p>Simply adds a “Skip” button next to quest conditions <strong>in the trader quest screens</strong>, letting you easily autocomplete any task.</p>\n<p>The default hotkey to make the Skip buttons appear is Left Control!<br />\n(you need to hold the button down)</p>\n<p>The binding can be changed in the F12 menu.</p>\n<p>Huge thanks to <a target=\"_blank\" class=\"external-link\" href=\"https://hub.sp-tarkov.com/user/18717-amands2mello/\" rel=\"noreferrer noopener\">Amands2Mello</a> for the awesome mod icon</p>\n<p>Big thanks to <a target=\"_blank\" class=\"external-link\" href=\"https://hub.sp-tarkov.com/user/24144-devraccoon/\" rel=\"noreferrer noopener\">Hazel</a> for compiling the 3.9 and 3.10 releases of this mod</p>\n<p><strong>Known issues:</strong></p>\n<ul>\n<li>Toggling the mod via configuration manager requires you to navigate away and back to the quest task screen for changes to apply</li>\n<li>Quest condition completion status isn’t saved to profile for now. Please only autocomplete conditions when you’re ready to actually complete the quest, otherwise the skipped conditions will reset to previous values after a raid or game restart!</li>\n</ul>\n<p><em>Self-control not included</em></p>\n", "versions": [{"version": "1.1.2", "spt_version_constraint": "~3.10.0", "content_length": null, "downloads": 42140, "published_at": "2024-11-26T20:15:45.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1343/skipper/1.1.2", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.3", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 71282, "published_at": "2025-03-17T18:19:09.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1343/skipper/1.1.3", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.4", "spt_version_constraint": "~4.0 <4.1.0", "content_length": 5182, "downloads": 122738, "published_at": "2025-10-23T00:08:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1343/skipper/1.1.4", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.5", "spt_version_constraint": "~4.1", "content_length": 5511, "downloads": 2453, "published_at": "2026-08-09T07:42:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1343/skipper/1.1.5", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}], "repos": ["TerkoizLT/SPT-Skipper", "acidphantasm/SPT-Skipper"], "source_code_links": [{"url": "https://github.com/TerkoizLT/SPT-Skipper", "label": "3.11"}, {"url": "https://github.com/acidphantasm/SPT-Skipper", "label": "4.0"}], "required_by": 0, "no_repo": false, "obtainable": true, "dep_problems": 0}