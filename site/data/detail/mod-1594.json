ps://forge.sp-tarkov.com/mod/download/1594/apbs-acids-progressive-bot-system/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.0", "spt_version_constraint": "~3.9.0", "content_length": null, "downloads": 5015, "published_at": "2024-09-27T00:23:11.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1594/apbs-acids-progressive-bot-system/1.1.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.2.0", "spt_version_constraint": "3.10.1", "content_length": null, "downloads": 181, "published_at": "2024-11-26T15:06:16.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1594/apbs-acids-progressive-bot-system/1.2.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.2.1", "spt_version_constraint": "3.10.1", "content_length": null, "downloads": 1879, "published_at": "2024-11-26T16:34:40.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1594/apbs-acids-progressive-bot-system/1.2.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.2.2", "spt_version_constraint": "3.10.1", "content_length": null, "downloads": 1982, "published_at": "2024-11-30T22:25:26.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1594/apbs-acids-progressive-bot-system/1.2.2", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.2.3", "spt_version_constraint": "3.10.1", "content_length": null, "downloads": 1873, "published_at": "2024-12-05T03:52:33.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1594/apbs-acids-progressive-bot-system/1.2.3", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "u