{"kind": "mod", "id": 2732, "name": "Quest Filter Mod", "slug": "quest-filter-mod", "teaser": "A mod for changing quests and a random quest generator with rewards.", "owner_name": "cccpvs", "downloads": 1370, "favourites": 8, "featured": false, "contains_ads": false, "contains_ai_content": true, "cheat_notice": false, "license_name": null, "guid": "com.cccpvs.questfiltermod", "thumbnail_local": null, "category": "Quests", "category_id": 7, "updated_at": "2026-07-28T18:02:31.000000Z", "created_at": "2026-06-10T19:12:40.000000Z", "published_at": "2026-06-10T19:19:00.000000Z", "latest_constraint": "4.0.13", "latest_version": "1.0.4", "has_local": false, "has_github": false, "license_link": null, "description_html": "<p>A mod for sorting standard or modded quests, removing conditions, binding to a merchant, location, and randomizing.</p>\n<p>A random generator of standard tasks, across various locations, conditions, and reward settings.</p>\n<p>Linear tasks with new tasks unlocking as you complete them.</p>\n<p>Removal of temporary and arena quests.</p>\n<hr />\n<p>For a full description, read <strong>README.md</strong> for the basic setup, and <strong>RandomQuests/README.md</strong> for the random quest setup.</p>\n<hr />\n<p>This mod does not save created quests, their order, or filtering. It creates a temporary quest list for each SPT server launch.</p>\n<hr />\n<p>Report any bugs, errors, or problems you notice. Happy hunting.</p>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "4.0.13", "content_length": 41801, "downloads": 440, "published_at": "2026-06-10T19:19:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2732/quest-filter-mod/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": []}, {"version": "1.0.1", "spt_version_constraint": "4.0.13", "content_length": 53438, "downloads": 191, "published_at": "2026-06-21T10:53:00.000000Z", "forge_link": "https://forge.