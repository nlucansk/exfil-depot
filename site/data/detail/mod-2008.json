": "1.3.1", "spt_version_constraint": "~4.0.0", "content_length": 15430, "downloads": 5277, "published_at": "2025-12-29T13:01:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2008/transmog/1.3.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": [{"id": 938, "name": "Custom Interactions", "slug": "custom-interactions", "status": "ok"}]}], "repos": ["szszss/EFT.Transmog"], "source_code_links": [{"url": "https://github.com/szszss/EFT.Transmog", "label": ""}], "required_by": 0, "no_repo": false, "obtainable": true, "dep_problems": 0}