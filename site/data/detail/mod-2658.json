{"kind": "mod", "id": 2658, "name": "Camo And Stickers", "slug": "camo-and-stickers", "teaser": "New era of Drip", "owner_name": "7Bpencil", "downloads": 37967, "favourites": 130, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "MIT License", "guid": "7bpencil.weaponcamoandstickers", "thumbnail_local": null, "category": "Weapons", "category_id": 13, "updated_at": "2026-08-09T18:02:46.000000Z", "created_at": "2026-04-05T19:20:12.000000Z", "published_at": "2026-04-08T00:45:00.000000Z", "latest_constraint": "4.1.*", "latest_version": "1.18.0", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<div class=\"tabset\"><div id=\"tabset-1-panel-1\" class=\"tab-panel\"><div class=\"tab-title\">PAINT GUNS</div>\n<div class=\"tab-content\"><p>One video speaks louder than thousand words: (also READ FAQ)</p>\n<div class=\"youtube-lite\" data-video-id=\"54NjlThfFv0\" data-embed-url=\"https://www.youtube-nocookie.com/embed/54NjlThfFv0?autoplay=1\"><img src=\"https://i.ytimg.com/vi/54NjlThfFv0/hqdefault.jpg\" alt=\"YouTube video thumbnail\" loading=\"lazy\" decoding=\"async\" /></div>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://raw.githubusercontent.com/7Bpencil/SPT.WeaponCamoAndStickers/refs/heads/master/previews/paint/m700-edit.png\" alt=\"\" />\n<img loading=\"lazy\" decoding=\"async\" src=\"https://raw.githubusercontent.com/7Bpencil/SPT.WeaponCamoAndStickers/refs/heads/master/previews/paint/m700-live.png\" alt=\"\" />\n<img loading=\"lazy\" decoding=\"async\" src=\"https://raw.githubusercontent.com/7Bpencil/SPT.WeaponCamoAndStickers/refs/heads/master/previews/paint/ash-animated.gif\" alt=\"\" />\n<img loading=\"lazy\" decoding=\"async\" src=\"https://raw.githubusercontent.com/7Bpencil/SPT.WeaponCamoAndStickers/refs/heads/master/previews/paint/mp7-live.png\" alt=\"\" />\n<img loading=\"lazy\" decoding=\"async\" src=\"https://raw.git