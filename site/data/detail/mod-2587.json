{"kind": "mod", "id": 2587, "name": "MassivesoftCore", "slug": "massivesoftcore", "teaser": "A library required for my mods to fuction.", "owner_name": "Massivesoft", "downloads": 26669, "favourites": 103, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "MIT License", "guid": "com.massivesoft.massivesoftcore", "thumbnail_local": null, "category": "Tools", "category_id": 1, "updated_at": "2026-07-28T08:05:07.000000Z", "created_at": "2026-02-13T13:29:57.000000Z", "published_at": "2026-02-13T13:06:00.000000Z", "latest_constraint": "~4.0.12", "latest_version": "1.0.2", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<div class=\"tabset\"><div id=\"tabset-1-panel-1\" class=\"tab-panel\"><div class=\"tab-title\">Overview</div>\n<div class=\"tab-content\"><p><strong>MassivesoftCore</strong> is a library required for my mods to fuction.  Basically it functions as an item loader and compatibility solver.</p>\n<p>You can use it as a dependency to build your own mod but <strong>no</strong> support or documentation will be provided.</p></div></div>\n<div id=\"tabset-1-panel-2\" class=\"tab-panel\"><div class=\"tab-title\">Installation</div>\n<div class=\"tab-content\"><p>Decompress and put the folder <strong>MassivesoftCore</strong> under <strong>[Your EFT Directory]/SPT/user/mods</strong></p>\n<p>For versions later than 1.0.2: Decompress and put the folder <strong>SPT</strong> under <strong>[Your EFT Directory]/</strong></p></div></div></div>\n", "versions": [{"version": "1.0.1", "spt_version_constraint": "~4.0.12", "content_length": 18512, "downloads": 856, "published_at": "2026-02-13T16:32:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2587/massivesoftcore/1.0.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.0.2", "spt_version_constra