{"kind": "mod", "id": 1297, "name": "Headshot Damage Redirection - HDR", "slug": "headshot-damage-redirection-hdr", "teaser": "Damage taken to your head will have a portion redirected to a random body part.", "owner_name": "Solarint", "downloads": 18688, "favourites": 0, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "MIT License", "guid": null, "thumbnail_local": null, "category": null, "category_id": null, "updated_at": "2026-07-07T16:58:54.000000Z", "created_at": "2024-04-10T10:02:20.000000Z", "published_at": "2024-04-10T10:02:20.000000Z", "latest_constraint": "~3.10.0", "latest_version": "1.3.1", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<p>This mod only works with the version is what built for (3.9 for the 3.9 version, and 3.8.3 for the 3.8 version)</p>\n<p>Only applies to you (not AI)</p>\n<p>Any damage taken to the head will now be redirected to a body part of your choosing.<br />\nYou can set what percentage of the damage to redirect.<br />\nSo if you redirect 75% of the damage, a shot that normally does 100 damage will instead do 25 damage to your head, and 75 damage to a random body part.<br />\nYou can select which parts are randomly selected, so you can have it only go to your torso, if you want.</p>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "3.8.0", "content_length": null, "downloads": 1311, "published_at": "2024-04-10T10:02:20.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1297/headshot-damage-redirection-hdr/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.1", "spt_version_constraint": "~3.8.0", "content_length": null, "downloads": 3132, "published_at": "2024-05-16T04:16:02.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1297/headshot-damage-redirection-hdr/1.1.