{"kind": "mod", "id": 910, "name": "Item Attribute Fix", "slug": "item-attribute-fix", "teaser": "A universal fix for item attribute tooltip not being updated when the attribute has changed while the inspection window is open.", "owner_name": "IcyClawz", "downloads": 21692, "favourites": 31, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": null, "guid": "com.icyclawz.itemattributefix", "thumbnail_local": null, "category": "Other", "category_id": 17, "updated_at": "2026-07-28T06:05:09.000000Z", "created_at": "2023-06-08T18:33:03.000000Z", "published_at": "2023-06-08T18:33:00.000000Z", "latest_constraint": "~4.0.0", "latest_version": "1.7.0", "has_local": false, "has_github": false, "license_link": null, "description_html": "<p><strong>Installation:</strong></p>\n<p>Extract the ZIP to your SPT-AKI installation folder.</p>\n<p><strong>Description:</strong></p>\n<p>The tooltip shown when hovering over an attribute in the item inspection window is static by default.</p>\n<p>In order to update it after an item has been changed (e.g. ammo added to a magazine, mods attached/detached to/from gear, etc.), the inspection window has to be closed and reopened.</p>\n<p>This simple client-side mod updates the tooltip’s text the moment the attribute is being updated.</p>\n<p>This fix can be used with any mod that utilizes the attribute tooltips (“FullStringValue” field of “ItemAttributeClass”).</p>\n<p>This fix was initially made as a companion to my “<a target=\"_blank\" class=\"external-link\" href=\"https://forge.sp-tarkov.com/mod/909/item-sell-price\" rel=\"noreferrer noopener\">Item Sell Price</a>” and “<a target=\"_blank\" class=\"external-link\" href=\"https://forge.sp-tarkov.com/mod/914/magazine-inspector\" rel=\"noreferrer noopener\">Magazine Inspector</a>” mods.</p>\n", "versions": [{"version": "1.5.0", "spt_version_constraint": "~3.10.0", "content_length": null, "downloads": 4818, "published_at": "2024-12-02T14:16:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/910/item-attribute-fix/1.5.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.6.0", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 7048, "published_at": "2025-03-25T07:31:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/910/item-attribute-fix/1.6.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.7.0", "spt_version_constraint": "~4.0.0", "content_length": 2736, "downloads": 9826, "published_at": "2025-10-18T17:43:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/910/item-attribute-fix/1.7.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}], "source_code_links": []}