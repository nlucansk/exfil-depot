ian localization layouts.</h5>\n<h5>And other settings…</h5>\n<p><em>Note: Not all quest markers are displayed yet.</em></p>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://imgup.uk/i/u1LlSytv.png\" alt=\"Image\" /></p>\n<p>If you find any bugs or have suggestions for new features, I’d be happy to hear your feedback.</p>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "~4 <4.1.0", "content_length": 12242, "downloads": 187, "published_at": "2026-06-22T23:16:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2765/compass-hud/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.0", "spt_version_constraint": "~4 <4.1.0", "content_length": 28626, "downloads": 653, "published_at": "2026-06-23T15:21:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2765/compass-hud/1.1.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.1", "spt_version_constraint": "~4 <4.1.0", "content_length": 29138, "downloads": 392, "published_at": "2026-06-28T10:46:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2765/compass-hud/1.1.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.2", "spt_version_constraint": "~4 <4.1.0", "content_length": 29138, "downloads": 2103, "published_at": "2026-07-02T11:59:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2765/compass-hud/1.1.2", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}], "repos": ["Vinarat0r/Compass-HUD"], "source_code_links": [{"url": "https://github.com/Vinarat0r/Compass-HUD", "label": "Code"}], "required_by": 0, "no_repo": false, "obtainable": true, "dep_problems": 0}