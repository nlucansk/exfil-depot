{"kind": "mod", "id": 1828, "name": "Configurable Armor Durability", "slug": "configurable-armor-durability", "teaser": "Configure durability of plates and inserts, as well as their blunt throughput.", "owner_name": "GeneralGoon", "downloads": 2306, "favourites": 0, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "MIT License", "guid": null, "thumbnail_local": null, "category": null, "category_id": null, "updated_at": "2026-05-14T03:22:34.000000Z", "created_at": "2024-11-08T15:13:18.000000Z", "published_at": "2024-11-08T15:13:18.000000Z", "latest_constraint": "~3.11.0", "latest_version": "1.1.0", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<p><strong>Configure durability of plates and inserts using a config file.</strong></p>\n<p><em><strong>Without editing the config this mod will change nothing</strong></em></p>\n<p><strong>Usage</strong></p>\n<p>To change armor durability:</p>\n<ol>\n<li>Open SPT\\user\\mods\\ConfigurableArmorDurability\\config\\config.json</li>\n<li>edit <em><strong>plateDurabilityMult</strong></em> to desired multiplier (higher is more)</li>\n<li>Save the file</li>\n</ol>\n<p><strong>Installation</strong></p>\n<ol>\n<li>Download</li>\n<li>Extract zip to SPT root</li>\n<li>Probably put at bottom of load order</li>\n</ol>\n<p><strong>Disclaimer:</strong></p>\n<p><strong>THIS CHANGES THE PLATE DURABILITY FOR BOTS TOO</strong></p>\n<p>I haven’t done much testing on the blunt throughput changes. Ideally a lower number = less blunt damage.</p>\n<p>s/o to Chomp for mod examples</p>\n", "versions": [{"version": "1.0.1", "spt_version_constraint": "~3.10.0", "content_length": null, "downloads": 880, "published_at": "2024-11-27T14:57:28.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1828/configurable-armor-durability/1.0.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.0.2", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 237, "published_at": "2025-05-11T21:16:40.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1828/configurable-armor-durability/1.0.2", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.0", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 766, "published_at": "2025-05-13T22:10:24.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1828/configurable-armor-durability/1.1.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}], "repos": ["GeneralGoon/ConfigurableArmorDurability"], "source_code_links": [{"url": "https://github.com/GeneralGoon/ConfigurableArmorDurability", "label": ""}], "required_by": 0, "no_repo": false, "obtainable": true, "dep_problems": 0}