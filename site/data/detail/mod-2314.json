{"kind": "mod", "id": 2314, "name": "Season Rotator", "slug": "season-rotator", "teaser": "Auto-rotate seasons at the pace you decide ", "owner_name": "turbodestroyer", "downloads": 28293, "favourites": 52, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "The Unlicense", "guid": "com.turbodestroyer.seasonrotator", "thumbnail_local": null, "category": "Other", "category_id": 17, "updated_at": "2026-08-08T18:02:21.000000Z", "created_at": "2025-09-17T07:36:27.000000Z", "published_at": "2025-09-17T07:36:00.000000Z", "latest_constraint": "~4.1.2", "latest_version": "2.0.1", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/unlicense/", "description_html": "<p>A very simple mod that automatically changes seasons.</p>\n<ul>\n<li>When first installed, the timer starts on the day of the first run.</li>\n<li>The first season will be whichever season comes next after your current one. For example, if you play vanilla SPT without season-changing mods and your current season is summer, the mod will switch to early autumn, then to late autumn, then to winter and so on</li>\n<li>In 2.0.0 (SPT 4.0) version, default setting is ~7 days for offseasons and ~14 days for winter and summer, you can change it in the config. The SPT 3.11 version is 7 days for each season.</li>\n<li>Not compatible with other season-changing mods (and not intended to be)</li>\n<li>Runs only when SPT server starts - so no season change in-game in edge cases</li>\n</ul>\n<hr />\n<p>This mod is meant to be simple. If you need more flexebility, you should probably use some of these mods:</p>\n<ul>\n<li><a target=\"_blank\" class=\"external-link\" href=\"https://hub.sp-tarkov.com/files/file/2796-tarkov-weather-system/\" rel=\"noreferrer noopener\">Tarkov Weather System</a></li>\n<li><a target=\"_blank\" class=\"external-link\" href=\"https://hub.sp-tarkov.com/files/file/2807-time-weather-changer-ng/\" rel=\"noreferrer noopener\">Time &amp; Weather Changer NG</a></li>\n<li><a target=\"_blank\" class=\"external-link\" href=\"https://hub.sp-tarkov.com/files/file/2118-simple-season-selector/\" rel=\"noreferrer noopener\">Simple Season Selector</a></li>\n</ul>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 1118, "published_at": "2025-09-17T07:36:27.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2314/season-rotator/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.1.0", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 3170, "published_at": "2025-09-21T08:18:55.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2314/season-rotator/1.1.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "2.0.0", "spt_version_constraint": "~4.0.0", "content_length": 24233, "downloads": 23228, "published_at": "2025-10-12T00:27:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2314/season-rotator/2.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "2.0.1", "spt_version_constraint": "~4.1.2", "content_length": 26134, "downloads": 777, "published_at": "2026-08-07T22:00:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2314/season-rotator/2.0.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": []}], "source_code_links": [{"url": "https://github.com/turbodestroyer1337/spt_season_rotator", "label": ""}]}