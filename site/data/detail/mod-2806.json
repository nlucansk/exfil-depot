{"kind": "mod", "id": 2806, "name": "Convoy", "slug": "convoy", "teaser": "the client side companion app for quartermaster", "owner_name": "cebarks", "downloads": 600, "favourites": 1, "featured": false, "contains_ads": false, "contains_ai_content": true, "cheat_notice": false, "license_name": "GNU AGPLv3", "guid": "io.cebarks.convoy", "thumbnail_local": null, "category": "Tools", "category_id": 1, "updated_at": "2026-07-28T09:38:47.000000Z", "created_at": "2026-07-08T00:01:52.000000Z", "published_at": "2026-07-08T00:01:00.000000Z", "latest_constraint": "~4 <4.1.0", "latest_version": "0.5.1", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/agpl-3.0/", "description_html": "<h1>Check out <a target=\"_blank\" class=\"external-link\" href=\"https://github.com/cebarks/quartermaster/\" rel=\"noreferrer noopener\">Quartermaster!</a></h1>\n<p>the client-side companion app for the Quartermaster control panel.</p>\n<h2>Features</h2>\n<h3>Currently only syncs client mods from the server to the client.</h3>\n<h4>How it works</h4>\n<ol>\n<li>Fetches the mod catalog from your Quartermaster server (with ETag caching)</li>\n<li>Diffs against local state to determine what needs to be installed, updated, or removed</li>\n<li>Downloads changed mods as a batch ZIP, extracts, and verifies SHA-256 hashes</li>\n<li>Prompts for a restart if any BepInEx plugin files changed (they’re already loaded by the time Convoy runs)</li>\n</ol>\n<h3>Planned Features</h3>\n<ul>\n<li>optional mod groups</li>\n<li>per-user mods that are managed and updated by the server, then pushed to the user</li>\n<li>server-authorative mod configs</li>\n<li>client setting backup (keybinds, graphics settings, etc.</li>\n</ul>\n<p>Feel free to open an issue on github for any bugs or feature requests!</p>\n", "versions": [{"version": "0.3.0", "spt_version_constraint": "~4.0.13", "content_length": 15100, "downloads": 107, "published_at": "2026-07-08T06:34:00.000000Z", "forge_