{"kind": "mod", "id": 2491, "name": "Zasten", "slug": "zasten", "teaser": "Adds a new underground trader...", "owner_name": "jayohh", "downloads": 15890, "favourites": 15, "featured": false, "contains_ads": false, "contains_ai_content": true, "cheat_notice": false, "license_name": "MIT License", "guid": "com.zasten.trader", "thumbnail_local": null, "category": "Traders", "category_id": 16, "updated_at": "2026-07-28T07:55:58.000000Z", "created_at": "2025-12-10T02:30:57.000000Z", "published_at": "2025-12-10T02:29:00.000000Z", "latest_constraint": "4.0.11", "latest_version": "2.2.3", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<p><strong>Zasten adds a late-game black-market trader to SPT with rare and unconventional gear, now featuring loyalty levels and quests.</strong></p>\n<hr />\n<p><strong>BUG REPORTING</strong></p>\n<ul>\n<li>If you run into bugs, report them in the comments with your <strong>SPT version, mod list, and server log.</strong></li>\n</ul>\n<hr />\n<p><strong>Future Plans</strong></p>\n<ul>\n<li>\n<p>More Quests, custom items, weapon presets</p>\n</li>\n<li>\n<p>Dependency for <a target=\"_blank\" class=\"external-link\" href=\"https://forge.sp-tarkov.com/mod/2512/wtt-content-backport\" rel=\"noreferrer noopener\">WTT – Content Backport</a></p>\n</li>\n</ul>\n<hr />\n<p><strong>Installation</strong>\nInstallation</p>\n<ol>\n<li>\n<p>Open the downloaded 7z file in 7-zip</p>\n</li>\n<li>\n<p>Select the folder in the 7z file in 7-zip</p>\n</li>\n<li>\n<p>Drag the selected folder from 7-zip into your SPT folder</p>\n</li>\n</ol>\n<hr />\n<p><strong>PATCH NOTES — VERSION 2.2</strong></p>\n<ul>\n<li>Removed Holiday Items &amp; Holiday Trader image</li>\n</ul>\n<p><strong>Quests &amp; Trader Progression</strong></p>\n<p><strong>13 new quests have been added to Zasten</strong></p>\n<ul>\n<li>One full questline is now complete: “Do It My Way”</li>\n<li>More quests and full questlines are in development</li>\n<li>Expanded Loyalty Level progression to improve early-game flow</li>\n</ul>\n<p><strong>Trader Inventory Updates</strong></p>\n<ul>\n<li>\n<p>Added multiple new items, with a focus on filling out LL1 trader stock</p>\n</li>\n<li>\n<p>Early-game offerings now provide more variety while maintaining balance</p>\n</li>\n</ul>\n<hr />\n<p><strong>New Item Added\nObdolbos-Z Cocktail Injector</strong></p>\n<p><strong>A modified Obdolbos stimulant available at LL4 Zasten, designed for extreme performance at a lasting cost.</strong></p>\n<p><strong>Positive Effects</strong></p>\n<ul>\n<li>\n<p>Increased stamina recovery</p>\n</li>\n<li>\n<p>+60% carry weight</p>\n</li>\n<li>\n<p>+30 Strength</p>\n</li>\n<li>\n<p>+30 Endurance</p>\n</li>\n<li>\n<p>+30 Attention</p>\n</li>\n<li>\n<p>+30 Perception</p>\n</li>\n</ul>\n<p><strong>Negative Effects</strong></p>\n<ul>\n<li>\n<p>Reduced maximum stamina</p>\n</li>\n<li>\n<p>Decreased health regeneration</p>\n</li>\n<li>\n<p>Increased hydration drain</p>\n</li>\n<li>\n<p>Increased energy drain</p>\n</li>\n</ul>\n<p><strong>Can be found In Raid Locations</strong></p>\n<ul>\n<li>\n<p>Dead Scavs</p>\n</li>\n<li>\n<p>Medical airdrops</p>\n</li>\n<li>\n<p>Lab technician bodies</p>\n</li>\n<li>\n<p>Medbags &amp; medcases</p>\n</li>\n<li>\n<p>Medical supply crates</p>\n</li>\n</ul>\n", "versions": [{"version": "2.0.0", "spt_version_constraint": "4.0.7", "content_length": 1256628, "downloads": 894, "published_at": "2025-12-11T02:14:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2491/zasten/2.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": []}, {"version": "2.1.0", "spt_version_constraint": "4.0.8", "content_length": 351994, "downloads": 1004, "published_at": "2025-12-13T00:42:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2491/zasten/2.1.0", "github_url": null, "external_url": null, "local_path": null,