{"kind": "mod", "id": 2277, "name": "Caliber Split Ammo Cases", "slug": "caliber-split-ammo-cases", "teaser": "Organize your ammo with caliber-specific cases for easier management!", "owner_name": "Szonszczyk", "downloads": 9602, "favourites": 16, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": null, "guid": "com.szonszczyk.calibersplitammocases", "thumbnail_local": null, "category": "Items", "category_id": 4, "updated_at": "2026-07-28T08:07:44.000000Z", "created_at": "2025-09-01T09:52:49.000000Z", "published_at": "2025-09-01T09:52:00.000000Z", "latest_constraint": "~4.0.0", "latest_version": "2.0.2", "has_local": false, "has_github": false, "license_link": null, "description_html": "<p>Adds procedurally generated ammo cases split by caliber, adapting automatically to the mods and ammunition available on your server.</p>\n<p>Choose between two generation modes: a full case for a single caliber or columns per ammo type.</p>\n<p>A detailed config file allows you to change the mode and customize sizes of the case.</p>\n<h3><strong>Features</strong></h3>\n<ul>\n<li>Automatically generates cases for all ammunition in the game (including modded ammo, 40×46 grenades, and even flares)</li>\n<li>Two modes to choose: one case per caliber or column per ammo type (configurable)</li>\n<li>Cases can be added to traders: Peacekeeper (USD), Ref (GP Coin), Skier (EUR), Jaeger (RUB), or Prapor (barter)</li>\n<li>Config options for background color, width, height and price of cases</li>\n</ul>\n<h3><strong>Compatibility</strong></h3>\n<p>Fully compatible with all mods that add ammo to the game. Load this mod after all mods that are adding new ammo for proper function.</p>\n<p>For best results (correct naming and filtering out invalid/unneeded calibers), review the config file.</p>\n<h3><strong>Credits</strong></h3>\n<p>Part of typescript codebase by GroovypenguinX</p>\n<p>Based on idea from <a target=\"_blank\" class=\"external-link\" href=\"https://forge.sp-tarkov.com/mod/2114/sptarkovammocases/\" rel=\"noreferrer noopener\">ragnaroks-SPTarkovAmmoCases</a></p>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/eHZPc4o.png\" alt=\"eHZPc4o.png\" /></p>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/bKUUled.png\" alt=\"bKUUled.png\" /></p>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/1IEjWWz.png\" alt=\"1IEjWWz.png\" /></p>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 1508, "published_at": "2025-09-01T09:52:49.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2277/caliber-split-ammo-cases/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "2.0.0", "spt_version_constraint": "~4.0.0", "content_length": 21222, "downloads": 3942, "published_at": "2025-10-24T04:31:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2277/caliber-split-ammo-cases/2.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.0.1", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 321, "published_at": "2025-10-25T21:16:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2277/caliber-split-ammo-cases/1.0.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "2.0.1", "spt_version_constraint": "~4.0.0", "content_length": 21814, "downloads": 811, "published_at": "2026-02-05T07:12:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2277/caliber-split-ammo-cases/2.0.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": []}, {"version": "2.0.2", "spt_version_constraint": "~4.0.0", "content_length