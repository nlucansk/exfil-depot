{"kind": "mod", "id": 707, "name": "Fontaine's Headbob Reducer", "slug": "fontaines-headbob-reducer", "teaser": "Let's you set the headbob game setting slider to 0.", "owner_name": "Fontaine", "downloads": 17330, "favourites": 1, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "Creative Commons BY-NC-SA 3.0", "guid": null, "thumbnail_local": "thumbs/948.jpg", "category": null, "category_id": null, "updated_at": "2026-07-13T18:03:54.000000Z", "created_at": "2023-01-08T23:13:18.000000Z", "published_at": "2023-01-08T23:13:18.000000Z", "latest_constraint": "~3.11.0", "latest_version": "1.7.0", "has_local": false, "has_github": false, "license_link": "http://creativecommons.org/licenses/by-nc-sa/3.0/legalcode", "description_html": "<h3><strong>Headbob Reducer</strong></h3>\n<p>Let’s you set the headbob game setting slider to 0. That’s it. Nothing more, nothing less.</p>\n<p>This doesn’t remove the side-side movement when sprinting and walking that patch 12.12 introduced, that seems baked into the animation. However it does reduce some of that headbob and removes the head movements when reloading, opening inventory etc.</p>\n<p>To install, simply put the .dll file into your BepInEx/Plugins folder.</p>\n", "versions": [{"version": "1.3.0", "spt_version_constraint": "3.7.1", "content_length": null, "downloads": 2389, "published_at": "2023-10-18T10:55:27.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/707/fontaines-headbob-reducer/1.3.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.4.0", "spt_version_constraint": "3.8.0", "content_length": null, "downloads": 1912, "published_at": "2024-04-21T23:42:43.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/707/fontaines-headbob-reducer/1.4.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies"