{"kind": "mod", "id": 2851, "name": "SPT Mod Manager", "slug": "spt-mod-manager", "teaser": "Open-source mod manager for SPT featuring easy installation, management and Forge integration.", "owner_name": "TioEmir", "downloads": 7077, "favourites": 26, "featured": false, "contains_ads": false, "contains_ai_content": true, "cheat_notice": false, "license_name": null, "guid": "com.nevek20.sptmodmanager", "thumbnail_local": null, "category": "Other", "category_id": 17, "updated_at": "2026-08-09T06:02:27.000000Z", "created_at": "2026-07-27T19:09:50.000000Z", "published_at": "2026-07-27T19:03:00.000000Z", "latest_constraint": "4.1.0", "latest_version": "0.4.6", "has_local": false, "has_github": false, "license_link": null, "description_html": "<h2>SPT Mod Manager</h2>\n<p>A Vortex/MO2-style mod manager built specifically for Single Player Tarkov. It came out of a real pain point: I got tired of having to hunt down files one by one just to uninstall a mod that was causing conflicts, so I decided to build a tool that would solve that for good.</p>\n<h3>What it does</h3>\n<ul>\n<li>Installs <code>.zip</code>, <code>.7z</code>, and <code>.rar</code> mods with automatic structure detection (Server, Client, or Hybrid)</li>\n<li>Enable/disable mods without deleting anything</li>\n<li>Rename, uninstall, and reinstall mods (reinstall works if you still have the original archive)</li>\n<li>Export and import mod lists</li>\n<li>Conflict detection by name (still basic, but improving)</li>\n<li>Forge integration: browse and install mods directly from the app, view mod info, download the right version, and check for updates</li>\n<li>Bilingual UI (PT-BR and EN)</li>\n</ul>\n<h3>Installation</h3>\n<p>Download the <code>.zip</code>, run the <code>.exe</code>. It installs everything automatically and creates a desktop shortcut.</p>\n<h3>Current limitations</h3>\n<ul>\n<li>Only tested with compressed archives (no folder-based installs yet)</li>\n<li>Doesn’t modify any SPT core files (only copies/organizes)</li>\n<li>Fully tested and supported only on the latest SPT version (older versions should work, but without guarantees)</li>\n<li>Windows only for now (Linux/macOS support planned, but i need to refine the Mod Manager first)</li>\n</ul>\n<p>Personal project, not affiliated with the SPT team or Battlestate Games.</p>\n", "versions": [{"version": "0.3.0", "spt_version_constraint": "4.", "content_length": 175296154, "downloads": 98, "published_at": "2026-07-27T19:38:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2851/spt-mod-manager/0.3.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "0.3.1", "spt_version_constraint": "4", "content_length": 175294265, "downloads": 265, "published_at": "2026-07-27T22:06:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2851/spt-mod-manager/0.3.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": []}, {"version": "0.3.2", "spt_version_constraint": "4", "content_length": 175284226, "downloads": 237, "published_at": "2026-07-28T21:02:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2851/spt-mod-manager/0.3.2", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": []}, {"version": "0.4.0", "spt_version_constraint": "4", "content_length": 175283249, "downloads": 64, "published_at": "2026-07-29T23:54:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2851/spt-mod-manager/0.4.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "compatible", "dependencies": []}, {"version": "0.4.1", "spt_version_constraint": "4", "content_length": 175284689, "downloads": 235, "published_at": "2026-07-30T01:20:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2851/spt-mod-manager/0.4.1", "github_url": null,