{"kind": "mod", "id": 1252, "name": "SPT Mods Installer", "slug": "spt-mods-installer", "teaser": "A simple little application that allows drag-and-dropping mods in zip formats.", "owner_name": "Devraccoon", "downloads": 41385, "favourites": 30, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": null, "guid": "com.hazelify.sptmodsinstaller", "thumbnail_local": null, "category": "Tools", "category_id": 1, "updated_at": "2026-07-28T06:09:17.000000Z", "created_at": "2024-02-24T20:10:02.000000Z", "published_at": "2024-02-24T20:10:00.000000Z", "latest_constraint": "~4.0 <4.1.0", "latest_version": "2.0.0", "has_local": false, "has_github": false, "license_link": null, "description_html": "<h3>Simple installation guide:</h3>\n<ul>\n<li>Download the app from the blue button next to the title.</li>\n<li>Extract <strong>SPT Mods Installer.exe</strong> to any existing SPT folder (same place as <strong>EscapeFromTarkov.exe</strong>).</li>\n<li>Run <strong>SPT Mods Installer.exe</strong>.</li>\n<li>Drag and drop any compressed archives into the application (supported extensions: .rar, .zip, .7z).</li>\n</ul>\n<h3>Caveat</h3>\n<p>This tool has no safeguards against how many mods you run through it. If it freezes while installing a mod, <em>it is working as intended</em>. Please be patient.</p>\n<h3>Credits</h3>\n<p>Thanks to <a target=\"_blank\" class=\"external-link\" href=\"https://www.flaticon.com/free-icon/dimensions_1083636?term=layer&amp;page=1&amp;position=20&amp;origin=search&amp;related_id=1083636\" rel=\"noreferrer noopener\">flaticon.com</a> for their amazing collection of logos</p>\n<p>As usual, always available on Discord:</p>\n<ul>\n<li><strong>net.hazelify or the <a target=\"_blank\" class=\"external-link\" href=\"https://discord.com/invite/Xn9msqQZan\" rel=\"noreferrer noopener\">SPT Discord server</a></strong></li>\n</ul>\n", "versions": [{"version": "1.9.0", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 11341, "published_at": "2025-01-09T00:51:14.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1252/spt-mods-installer/1.9.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "2.0.0", "spt_version_constraint": "~4.0 <4.1.0", "content_length": 2523525, "downloads": 16775, "published_at": "2025-10-26T21:08:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1252/spt-mods-installer/2.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}], "source_code_links": []}