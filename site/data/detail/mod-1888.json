{"kind": "mod", "id": 1888, "name": "Better Keys NG", "slug": "better-keys-ng", "teaser": "Get some useful info about each key. Is it required for a quest? What is behind the lock? Is it used to exit/transit ?", "owner_name": "flir", "downloads": 50767, "favourites": 81, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "MIT License", "guid": "com.flir.betterkeys", "thumbnail_local": null, "category": "Other", "category_id": 17, "updated_at": "2026-07-28T08:06:21.000000Z", "created_at": "2024-12-13T18:17:39.000000Z", "published_at": "2024-12-13T18:17:00.000000Z", "latest_constraint": "~4.0 <4.1.0", "latest_version": "1.7.1", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<h1>Features</h1>\n<p>Colored background for keys and keycards according to which map they belongs to.</p>\n<p>Maps, Extracts, Quests and Loot information in the item descriptions.</p>\n<p>Possibility to rename all keys to add a custom prefix based on the map they “belong to”.</p>\n<p>Users can copy the config.jsonc file to a file named configuser.jsonc which will be read in priority if present. This allows to keep your config while updating (You will need to copy/paste any new entry if/when they appear in the config.jsonc though)</p>\n", "versions": [{"version": "1.3.1", "spt_version_constraint": "~3.10.0", "content_length": null, "downloads": 820, "published_at": "2024-12-13T18:17:39.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1888/better-keys-ng/1.3.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.3.8", "spt_version_constraint": "3.10.5", "content_length": null, "downloads": 237, "published_at": "2025-01-16T09:49:22.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1888/better-keys-ng/1.3.8", "github_url": null, "external_url": null, "local_