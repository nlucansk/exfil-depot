{"kind": "mod", "id": 1750, "name": "Item dump tool", "slug": "item-dump-tool", "teaser": "Export full item templates from the SPT database on server boot.", "owner_name": "Gipphe", "downloads": 353, "favourites": 0, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "MIT License", "guid": null, "thumbnail_local": null, "category": null, "category_id": null, "updated_at": "2026-07-07T16:59:02.000000Z", "created_at": "2024-09-27T22:26:46.000000Z", "published_at": "2024-09-27T22:26:46.000000Z", "latest_constraint": "~3.9.0", "latest_version": "1.0.0", "has_local": false, "has_github": false, "license_link": "https://choosealicense.com/licenses/mit/", "description_html": "<p>Only really useful when developing mods that require such files for their development.</p>\n<p>If you need this, you will know.</p>\n<p>Specify which items to dump in gipphe-sptdumpitems/config/config.json. Dumped JSON will be written to gipphe-sptdumpitems/data.</p>\n<p>Place last in your load order to ensure templates are loaded and that any changes made by any mods are in effect.</p>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "~3.9.0", "content_length": null, "downloads": 353, "published_at": "2024-09-27T22:26:46.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1750/item-dump-tool/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}], "repos": ["Gipphe/spt-dump-items"], "source_code_links": [{"url": "https://github.com/Gipphe/spt-dump-items", "label": ""}], "required_by": 0, "no_repo": false, "obtainable": true, "dep_problems": 0}