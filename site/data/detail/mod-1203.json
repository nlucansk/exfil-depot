al-link\" href=\"https://imgur.com/JUc0C7Z.gif\" rel=\"noreferrer noopener\"><img loading=\"lazy\" decoding=\"async\" src=\"https://imgur.com/JUc0C7Z.gif\" alt=\"JUc0C7Z.gif\" /></a></p>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "~3.7.0", "content_length": null, "downloads": 894, "published_at": "2023-12-31T20:24:32.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1203/loadout-terminal/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}], "repos": ["waffle-lord/LoadoutTerminal"], "source_code_links": [{"url": "https://github.com/waffle-lord/LoadoutTerminal", "label": ""}], "required_by": 0, "no_repo": false, "obtainable": true, "dep_problems": 0}