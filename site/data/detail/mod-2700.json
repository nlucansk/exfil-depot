{"kind": "mod", "id": 2700, "name": "knife sprint", "slug": "knife-sprint", "teaser": "a simple mod letting you sprint faster with your knife out ", "owner_name": "20fpsguy", "downloads": 6694, "favourites": 47, "featured": false, "contains_ads": false, "contains_ai_content": true, "cheat_notice": false, "license_name": null, "guid": "com.20fpsguy.knifesprint", "thumbnail_local": null, "category": "Other", "category_id": 17, "updated_at": "2026-08-05T18:36:17.000000Z", "created_at": "2026-05-20T23:34:09.000000Z", "published_at": "2026-05-20T23:36:00.000000Z", "latest_constraint": "~4.1", "latest_version": "1.0.1", "has_local": false, "has_github": false, "license_link": null, "description_html": "<p>KnifeSprint gives you a small sprint speed boost whenever your melee weapon is out. Default is a subtle 15% enough to feel snappier without being broken. Fully configurable in BepInEx if you want more or less.</p>\n<p>Switching back to your gun mid-sprint? Boost drops instantly, so no you cant cheese, or can you? :D</p>\n<p>Config: Sprint Speed Multiplier default 1.15, range 1.0–2.0</p>\n<h1>All settings are available in the F12 BepInEx menu in-game.</h1>\n", "versions": [{"version": "1.0.0", "spt_version_constraint": "4.0.13", "content_length": 3366, "downloads": 5136, "published_at": "2026-05-20T23:34:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2700/knife-sprint/1.0.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "1.0.1", "spt_version_constraint": "~4.1", "content_length": 3302, "downloads": 1558, "published_at": "2026-08-01T20:44:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/2700/knife-sprint/1.0.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}], "source_code_links": []}