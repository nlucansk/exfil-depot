{"kind": "mod", "id": 1292, "name": "SamSWAT's Helicopter Crash Sites - Arys Reloaded", "slug": "samswats-helicopter-crash-sites-arys-reloaded", "teaser": "SamSWAT's Helicopter Crash Sites - DayZ inspired helicrashes now in Tarkov", "owner_name": "Arys", "downloads": 52212, "favourites": 58, "featured": false, "contains_ads": false, "contains_ai_content": false, "cheat_notice": false, "license_name": "Creative Commons BY-NC 3.0", "guid": "com.samswat.helicrash.arysreloaded", "thumbnail_local": null, "category": "Locations", "category_id": 8, "updated_at": "2026-07-28T09:23:22.000000Z", "created_at": "2024-04-08T00:43:00.000000Z", "published_at": "2024-04-08T00:43:00.000000Z", "latest_constraint": "~4.0.3", "latest_version": "2.5.2", "has_local": false, "has_github": false, "license_link": "http://creativecommons.org/licenses/by-nc/3.0/legalcode", "description_html": "<div class=\"tabset\"><div id=\"tabset-1-panel-1\" class=\"tab-panel\"><div class=\"tab-title\">Description</div>\n<div class=\"tab-content\"><p><a target=\"_blank\" class=\"external-link\" href=\"https://hub.sp-tarkov.com/files/file/659-helicopter-crash-sites/\" rel=\"noreferrer noopener\">Original Mod by SamSWAT</a></p>\n<p>A BepInEx client mod that adds DayZ-inspired helicopter crashes to SPT.</p>\n<h3>— FIKA USERS —</h3>\n<p>You need the <a target=\"_blank\" class=\"external-link\" href=\"https://forge.sp-tarkov.com/addon/12/samswats-helicopter-crash-sites-arys-reloaded-fika-sync\" rel=\"noreferrer noopener\">Fika Sync addon</a> to make the mod work on Fika. Please follow the install instructions on the Fika Sync addon’s page.</p>\n<h3>————————</h3>\n<p>Helicopter crash sites have a configurable spawn chance (default is 10%), and can spawn with a lootable crate (the default crate spawn chance is 100% and is also configurable).</p>\n<p>This mod was originally made by SamSWAT, was updated by Tyrian for 3.7.x and now I’m maintaining the mod, for the foreseeable future.</p></div></div>\n<div id=\"tabset-1-panel-2\" class=\"tab-panel\"><div class=\"tab-title\">Installation</div></div>\n<div id=\"tabset-1-panel-3\" class=\"tab-panel\"><div class=\"tab-title\">HOW TO INSTALL</div>\n<div class=\"tab-content\"><ol>\n<li>Download and install the dependency mod UnityToolkit</li>\n<li>Download this mod and open the file with 7-Zip</li>\n<li>Drag and drop the <strong>BepInEx</strong> folder into your game folder (not the SPT folder inside your game folder!)</li>\n</ol></div></div>\n<div id=\"tabset-1-panel-4\" class=\"tab-panel\"><div class=\"tab-title\">Credits</div>\n<div class=\"tab-content\"><p><strong>SamSWAT - creator of the original mod</strong></p>\n<p><strong>Tyrian - codebase I inherited from</strong></p></div></div></div>\n", "versions": [{"version": "2.2.1", "spt_version_constraint": "3.8.0", "content_length": null, "downloads": 9574, "published_at": "2024-04-08T00:43:00.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1292/samswats-helicopter-crash-sites-arys-reloaded/2.2.1", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "2.2.2", "spt_version_constraint": "3.8.1", "content_length": null, "downloads": 7344, "published_at": "2024-05-19T02:12:29.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1292/samswats-helicopter-crash-sites-arys-reloaded/2.2.2", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "2.3.0", "spt_version_constraint": "~3.11.0", "content_length": null, "downloads": 13849, "published_at": "2025-04-19T02:18:28.000000Z", "forge_link": "https://forge.sp-tarkov.com/mod/download/1292/samswats-helicopter-crash-sites-arys-reloaded/2.3.0", "github_url": null, "external_url": null, "local_path": null, "fika_compatibility": "unknown", "dependencies": []}, {"version": "2.4.0", "spt_version_constraint": "~4.0.3", "content_length": 29354949, "downloads": 1015, "publishe